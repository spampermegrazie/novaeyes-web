# Cal event link. Defaults to novaeyes/novaeyes-intro-call (the live site's event).
NEXT_PUBLIC_CAL_LINK=

# Dashboard project origin for the /app proxy, no trailing slash
DASHBOARD_ORIGIN=

# The database the Lovable app uses (values from that repo's .env)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional. Only needed if the leads table doesn't allow anonymous inserts.
SUPABASE_SERVICE_ROLE_KEY=

# Estimate emails
RESEND_API_KEY=
LEADS_FROM_EMAIL="NovaEyes <hello@nova-eyes.com>"

# Shared secret for POST /api/revalidate (refreshes blog posts after publishing)
REVALIDATE_SECRET=
